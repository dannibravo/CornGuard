# Built application files
*.apk
*.aab
*.ap_
*.aar

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (contains SDK path and machine-specific values)
local.properties

# Log/profiler files
*.log
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws
.DS_Store

# Keystores — never commit a release signing key (see claude/10_ENV_GUIDE.md)
*.jks
*.keystore

# app/google-services.json (FCM client config) is committed on purpose: it holds public app
# identifiers, not secrets, and is the only copy since the firebase/ folder was removed.

# Freeze reports
lint-results*.html
lint-results*.xml
