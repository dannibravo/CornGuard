<?xml version="1.0" encoding="utf-8"?>
<!-- Diagnosis result bottom sheet (caps 3 design). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/resultCloseButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_close"
            app:tint="@color/cg_text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/resultThumbnail"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_thumbnail"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/resultLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cg_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="Common Rust" />

                <TextView
                    android:id="@+id/resultConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/cg_accent_green"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="Confidence: 95.0%" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/resultLocationIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_location"
                        app:tint="@color/cg_accent_green" />

                    <TextView
                        android:id="@+id/resultLocationStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/cg_accent_green"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Poblacion, City of Valencia" />
                </LinearLayout>

                <TextView
                    android:id="@+id/resultSetLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:text="@string/result_set_location"
                    android:textColor="@color/cg_warning"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CornGuard.Card.Inset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recommended_action"
                    android:textAppearance="@style/TextAppearance.CornGuard.SectionHeader" />

                <TextView
                    android:id="@+id/resultTreatmentPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textAppearance="@style/TextAppearance.CornGuard.Body"
                    android:textSize="17sp"
                    tools:text="Chemical Option:\nApply foliar fungicides like 'Amistar 25 SC'…" />

                <TextView
                    android:id="@+id/resultViewDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:paddingVertical="4dp"
                    android:text="@string/view_full_details"
                    android:textAppearance="@style/TextAppearance.CornGuard.Link" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/resultMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.CornGuard.Meta"
            tools:text="Scanned Sep 27, 2026 8:36 PM · cornguard_mobilenetv2_v3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareToCommunityButton"
            style="@style/Widget.CornGuard.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="60dp"
            android:text="@string/result_share_action" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/shareProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/cg_primary" />

        <TextView
            android:id="@+id/shareError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/cg_danger"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Sign in to share this result with the community."
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/cg_text_tertiary" />

            <TextView
                android:id="@+id/resultSavedNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/result_saved_note"
                android:textAppearance="@style/TextAppearance.CornGuard.Meta" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
