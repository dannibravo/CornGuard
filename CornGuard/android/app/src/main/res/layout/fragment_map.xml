<?xml version="1.0" encoding="utf-8"?>
<!--
    Outbreak map (UI redesign v2): full-height Leaflet heatmap in a WebView, floating back button
    and title chip, and a bottom sheet (collapsed 96dp: handle + barangay + level; expanded
    286dp / 330dp with Large text: disease pills, explanation, privacy note, then the earlier
    "Reports near you" lists). MapFragment keeps the map's bottom inset in step with the sheet.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cg_bg">

    <WebView
        android:id="@+id/mapWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating top row; its height is the map's top inset. The Back button is hidden on the Map tab,
         so the page puts its closed search button level with the title chip. -->
    <FrameLayout
        android:id="@+id/mapHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/mapBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_map_control"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/cg_text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_map_control"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:screenReaderFocusable="true"
            tools:targetApi="28">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold_family"
                android:text="@string/map_chip_title"
                android:textColor="@color/cg_text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_chip_subtitle"
                android:textColor="@color/cg_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Signed out: the map is for signed-in users. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mapSignedOut"
        style="@style/Widget.CornGuard.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_map"
                app:tint="@color/cg_accent_amber" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/map_sign_in_prompt"
                android:textColor="@color/cg_text_secondary"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mapSignInButton"
                style="@style/Widget.CornGuard.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/auth_required_signin_cta" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom sheet. Height is set in MapFragment (286dp, or 330dp with Large text). -->
    <LinearLayout
        android:id="@+id/mapReportsSheet"
        android:layout_width="match_parent"
        android:layout_height="@dimen/map_sheet_expanded"
        android:background="@drawable/bg_sheet_top"
        android:elevation="12dp"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/map_sheet_peek"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Handle: full-width 34dp target with a 44x5 bar; tap toggles, drag moves the sheet. -->
        <FrameLayout
            android:id="@+id/mapSheetHandle"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="@string/map_sheet_expand"
            android:focusable="true">

            <View
                android:layout_width="44dp"
                android:layout_height="5dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_sheet_handle" />
        </FrameLayout>

        <!-- Collapsed content: selected barangay + level (62dp, so the peek is 96dp). -->
        <LinearLayout
            android:id="@+id/mapAreaRow"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mapAreaName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/cg_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Poblacion" />

                <TextView
                    android:id="@+id/mapAreaMunicipality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/cg_text_secondary"
                    android:textSize="13sp"
                    tools:text="Valencia" />
            </LinearLayout>

            <TextView
                android:id="@+id/mapLevelBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_pill"
                android:fontFamily="@font/inter_semibold_family"
                android:minHeight="28dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="13sp"
                android:visibility="gone"
                tools:backgroundTint="@color/level_severe_bg"
                tools:text="Severe"
                tools:textColor="@color/level_severe_text"
                tools:visibility="visible" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/mapSheetScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/mapContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp">

                <!-- Disease filter: one row, each pill grows from its content width (fits 358dp). -->
                <LinearLayout
                    android:id="@+id/mapDiseasePills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mapPillAll"
                        style="@style/Widget.CornGuard.MapPill"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:checked="true"
                        android:contentDescription="@string/map_pill_all_a11y"
                        android:text="@string/map_pill_all" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mapPillRust"
                        style="@style/Widget.CornGuard.MapPill"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:contentDescription="@string/map_pill_rust_a11y"
                        android:text="@string/map_pill_rust" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mapPillGrayLeafSpot"
                        style="@style/Widget.CornGuard.MapPill"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:contentDescription="@string/map_pill_gray_leaf_spot_a11y"
                        android:text="@string/map_pill_gray_leaf_spot" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mapPillBlight"
                        style="@style/Widget.CornGuard.MapPill"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:checkable="true"
                        android:contentDescription="@string/map_pill_blight_a11y"
                        android:text="@string/map_pill_blight" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mapAreaExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/cg_text_primary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4sp"
                    tools:text="Potential outbreak · Severe: 6 farms reported Common Rust in the last 7 days. Usual for this barangay: 1.5 farms a week." />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/map_privacy_note"
                    android:textColor="@color/cg_text_tertiary"
                    android:textSize="13sp" />

                <!-- The earlier "Reports near you" lists (farmer's profile barangay), kept. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/map_sheet_title"
                    android:textAppearance="@style/TextAppearance.CornGuard.SectionHeader" />

                <TextView
                    android:id="@+id/mapArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/cg_text_secondary"
                    android:textSize="13sp"
                    tools:text="Showing Poblacion, Valencia" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/map_verified_title"
                    android:textAppearance="@style/TextAppearance.CornGuard.SectionHeader" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CornGuard.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/mapVerifiedRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/mapVerifiedEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="20dp"
                            android:text="@string/map_verified_empty"
                            android:textColor="@color/cg_text_tertiary"
                            android:textSize="15sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="24dp"
                    android:text="@string/map_nearby_title"
                    android:textAppearance="@style/TextAppearance.CornGuard.SectionHeader" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CornGuard.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/mapNearbyRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/mapNearbyEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="20dp"
                            android:text="@string/map_nearby_empty"
                            android:textColor="@color/cg_text_tertiary"
                            android:textSize="15sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
