<?xml version="1.0" encoding="utf-8"?>
<!-- Notification inbox, opened from the Dashboard bell. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cg_bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cg_surface">

        <include
            android:id="@+id/notificationsHeader"
            layout="@layout/view_screen_header" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/notificationsMarkAllRead"
            style="@style/Widget.CornGuard.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="8dp"
            android:text="@string/notifications_mark_all_read"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cg_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/notificationsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            tools:listitem="@layout/item_notification" />

        <TextView
            android:id="@+id/notificationsEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="48dp"
            android:text="@string/notifications_empty"
            android:textColor="@color/cg_text_tertiary"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/notificationsSignedOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bell"
                app:tint="@color/cg_accent_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/notifications_sign_in_prompt"
                android:textColor="@color/cg_text_secondary"
                android:textSize="17sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/notificationsSignInButton"
                style="@style/Widget.CornGuard.Button.Primary"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/auth_required_signin_cta" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
