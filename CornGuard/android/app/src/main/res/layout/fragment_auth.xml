<?xml version="1.0" encoding="utf-8"?>
<!-- Sign in / Create account, styled like the caps 3 Edit Profile form. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cg_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_leaf"
            app:tint="@color/cg_accent_green" />

        <TextView
            android:id="@+id/authTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/auth_title_signin"
            android:textAppearance="@style/TextAppearance.CornGuard.ScreenTitle"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/auth_subtitle"
            android:textAppearance="@style/TextAppearance.CornGuard.Secondary"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/displayNameInput"
            style="@style/Widget.CornGuard.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="@string/auth_display_name_hint"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:visibility="gone" />

        <EditText
            android:id="@+id/emailInput"
            style="@style/Widget.CornGuard.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:autofillHints="emailAddress"
            android:hint="@string/auth_email_hint"
            android:inputType="textEmailAddress" />

        <!-- Password with a show/hide (eye) button inside the field, for sign-in and sign-up. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <EditText
                android:id="@+id/passwordInput"
                style="@style/Widget.CornGuard.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/auth_password_hint"
                android:inputType="textPassword"
                android:paddingEnd="56dp" />

            <ImageButton
                android:id="@+id/passwordToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/auth_show_password"
                android:src="@drawable/ic_visibility"
                app:tint="@color/cg_text_secondary" />
        </FrameLayout>

        <EditText
            android:id="@+id/barangayInput"
            style="@style/Widget.CornGuard.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/auth_barangay_hint"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:visibility="gone" />

        <EditText
            android:id="@+id/municipalityInput"
            style="@style/Widget.CornGuard.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/auth_municipality_hint"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:visibility="gone" />

        <EditText
            android:id="@+id/provinceInput"
            style="@style/Widget.CornGuard.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/auth_province_hint"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:visibility="gone" />

        <TextView
            android:id="@+id/authError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/cg_danger"
            android:textSize="15sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/authSubmitButton"
            style="@style/Widget.CornGuard.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="60dp"
            android:text="@string/auth_signin_action" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/authProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/cg_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/authToggleModeButton"
            style="@style/Widget.CornGuard.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auth_toggle_to_register" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/authSkipButton"
            style="@style/Widget.CornGuard.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auth_skip_action"
            android:textColor="@color/cg_text_secondary"
            android:textStyle="normal" />
    </LinearLayout>
</ScrollView>
