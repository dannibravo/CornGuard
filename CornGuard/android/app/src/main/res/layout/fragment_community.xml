<?xml version="1.0" encoding="utf-8"?>
<!-- Community feed (caps 3 design "Global Feed"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cg_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/communityHeader"
        layout="@layout/view_screen_header" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cg_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/communitySwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/communityRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="12dp"
                android:paddingBottom="96dp"
                tools:listitem="@layout/item_community_post" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <TextView
            android:id="@+id/communityEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="48dp"
            android:text="@string/community_empty"
            android:textColor="@color/cg_text_tertiary"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/communitySignedOut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_people"
                app:tint="@color/cg_accent_blue" />

            <TextView
                android:id="@+id/communitySignInPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/community_sign_in_prompt"
                android:textColor="@color/cg_text_secondary"
                android:textSize="17sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/communitySignInButton"
                style="@style/Widget.CornGuard.Button.Primary"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/auth_required_signin_cta" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/communityCreatePostButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="@string/create_post_title"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/cg_primary"
            app:fabCustomSize="68dp"
            app:maxImageSize="34dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:tint="#FFFFFF" />
    </FrameLayout>
</LinearLayout>
