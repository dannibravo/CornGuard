<?xml version="1.0" encoding="utf-8"?>
<!-- "Report post/comment" sheet: pick a reason, optional note, submit. Scrolls when the keyboard
     leaves little room, so the note field and Submit stay reachable. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reportTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.CornGuard.HeaderTitle"
                android:textSize="26sp"
                tools:text="@string/report_post_title" />

            <ImageButton
                android:id="@+id/reportClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_close"
                android:src="@drawable/ic_close"
                app:tint="@color/cg_text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/report_subtitle"
            android:textColor="@color/cg_text_secondary"
            android:textSize="15sp" />

        <!-- One RadioButton per ReportReason, added in ReportBottomSheet. -->
        <RadioGroup
            android:id="@+id/reportReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/reportNote"
            style="@style/Widget.CornGuard.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top|start"
            android:hint="@string/report_note_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="300"
            android:maxLines="4"
            android:minLines="2" />

        <TextView
            android:id="@+id/reportError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/report_failed"
            android:textColor="@color/cg_danger"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportCancel"
                style="@style/Widget.CornGuard.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_cancel"
                android:textSize="17sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportSubmit"
                style="@style/Widget.CornGuard.Button.Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:enabled="false"
                android:minHeight="56dp"
                android:text="@string/report_submit"
                android:textColor="@color/cg_post_button_text"
                android:textSize="17sp"
                app:backgroundTint="@color/cg_post_button_bg" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
