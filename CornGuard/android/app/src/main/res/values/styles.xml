<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text styles (sizes from the caps 3 design). -->
    <style name="TextAppearance.CornGuard.ScreenTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cg_text_primary</item>
    </style>

    <style name="TextAppearance.CornGuard.HeaderTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cg_text_primary</item>
    </style>

    <style name="TextAppearance.CornGuard.CardTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cg_text_primary</item>
    </style>

    <style name="TextAppearance.CornGuard.Label" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cg_text_primary</item>
    </style>

    <style name="TextAppearance.CornGuard.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/cg_text_primary</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.CornGuard.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/cg_text_secondary</item>
    </style>

    <style name="TextAppearance.CornGuard.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/cg_text_tertiary</item>
    </style>

    <style name="TextAppearance.CornGuard.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/cg_text_secondary</item>
    </style>

    <style name="TextAppearance.CornGuard.Link" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cg_accent_green</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.CornGuard.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cg_button_primary_bg</item>
        <item name="android:textColor">@color/cg_on_primary</item>
        <item name="iconTint">@color/cg_on_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.CornGuard.Button.Secondary" parent="Widget.CornGuard.Button.Primary">
        <item name="backgroundTint">@color/cg_button_secondary</item>
        <item name="android:textColor">@color/cg_on_button_secondary</item>
        <item name="iconTint">@color/cg_on_button_secondary</item>
    </style>

    <style name="Widget.CornGuard.Button.Pill" parent="Widget.CornGuard.Button.Primary">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
    </style>

    <style name="Widget.CornGuard.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/cg_accent_green</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconTint">@color/cg_accent_green</item>
    </style>

    <!-- Filled input (Edit Profile / Create Group fields in the design). -->
    <style name="Widget.CornGuard.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/cg_text_primary</item>
        <item name="android:textColorHint">@color/cg_text_tertiary</item>
    </style>

    <!-- Cards -->
    <style name="Widget.CornGuard.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/cg_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/cg_card_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.CornGuard.Card.Dashboard" parent="Widget.CornGuard.Card">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/cg_surface</item>
    </style>

    <style name="Widget.CornGuard.Card.Inset" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/cg_surface_raised</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Bottom navigation: design's Dashboard / History / Settings bar with a pill indicator. -->
    <style name="Widget.CornGuard.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/cg_nav_bg</item>
        <item name="backgroundTint">@color/cg_nav_bg</item>
        <item name="itemIconTint">@color/cg_nav_item</item>
        <item name="itemTextColor">@color/cg_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CornGuard.BottomNavigation.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.CornGuard.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.CornGuard.NavLabel</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.CornGuard.BottomNavigation.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/cg_nav_indicator</item>
    </style>

    <style name="TextAppearance.CornGuard.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">14sp</item>
    </style>
</resources>
