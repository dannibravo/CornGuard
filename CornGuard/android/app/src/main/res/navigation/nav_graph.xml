<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!--
        Bottom-nav destinations: homeFragment (Dashboard), historyFragment, profileFragment
        (Settings). Scan, Community and Map open from the Dashboard cards. The diagnosis result,
        full details, create-post, comments and edit-profile screens are bottom sheets opened in
        code, not graph destinations.
    -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.cornguard.app.ui.home.HomeFragment"
        android:label="@string/nav_dashboard"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_scan"
            app:destination="@id/scanFragment" />
        <action
            android:id="@+id/action_home_to_community"
            app:destination="@id/communityFragment" />
        <action
            android:id="@+id/action_home_to_map"
            app:destination="@id/mapFragment" />
    </fragment>

    <fragment
        android:id="@+id/scanFragment"
        android:name="com.cornguard.app.ui.scan.ScanFragment"
        android:label="@string/scan_title"
        tools:layout="@layout/fragment_scan" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.cornguard.app.ui.history.HistoryFragment"
        android:label="@string/history_title"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.cornguard.app.ui.map.MapFragment"
        android:label="@string/map_title"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/communityFragment"
        android:name="com.cornguard.app.ui.community.CommunityFragment"
        android:label="@string/community_title"
        tools:layout="@layout/fragment_community" />

    <!-- Reached from any online-only screen's sign-in prompt; never the start destination. -->
    <fragment
        android:id="@+id/authFragment"
        android:name="com.cornguard.app.ui.auth.AuthFragment"
        android:label="@string/auth_signin_action"
        tools:layout="@layout/fragment_auth" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.cornguard.app.ui.profile.ProfileFragment"
        android:label="@string/profile_title"
        tools:layout="@layout/fragment_profile" />

</navigation>
