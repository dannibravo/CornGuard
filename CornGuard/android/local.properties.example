# Copy this file to `local.properties` (already git-ignored) and fill in your machine-specific
# values. Do not commit `local.properties` — see claude/10_ENV_GUIDE.md.
#
# Forward slashes work fine in local.properties on Windows too, and avoid backslash-escaping
# mistakes in this Java-properties-format file.

sdk.dir=C:/Users/YOUR_USERNAME/AppData/Local/Android/Sdk

